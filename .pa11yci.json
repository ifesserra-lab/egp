{
  "defaults": {
    "standard": "WCAG2AA",
    "runners": [
      "axe",
      "htmlcs"
    ],
    "threshold": 0,
    "timeout": 30000,
    "chromeLaunchConfig": {
      "args": [
        "--no-sandbox"
      ]
    }
  },
  "urls": [
    "http://localhost:4321/",
    {
      "url": "http://localhost:4321/",
      "viewport": { "width": 360, "height": 800, "isMobile": true }
    },
    {
      "url": "http://localhost:4321/",
      "viewport": { "width": 360, "height": 800, "isMobile": true },
      "actions": [
        "click element #nav-botao",
        "wait for element #nav-lista to be visible"
      ],
      "hideElements": "main"
    }
  ]
}

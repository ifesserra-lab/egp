---
interface Props {
  nome: string;
  resumo: string;
  ordem: number;
  href: string;
}

const { nome, resumo, ordem, href } = Astro.props;
const numero = String(ordem).padStart(2, '0');
---

<article class="cartao">
  <span class="cartao__n">Pilar {numero}</span>
  <h3><a href={href}>{nome}</a></h3>
  <p>{resumo}</p>
</article>

<style>
  .cartao__n {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--marca);
    letter-spacing: 0.1em;
    display: block;
  }

  h3 {
    margin: 0;
    font-size: 1.125rem;
  }

  h3 a {
    text-decoration: none;
    color: var(--texto);
  }

  h3 a:hover {
    color: var(--marca-forte);
    text-decoration: underline;
  }

  p {
    margin: 0;
    color: var(--texto-suave);
    font-size: 0.9688rem;
  }
</style>

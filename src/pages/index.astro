---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import CanalAtendimento from '../components/CanalAtendimento.astro';
import TabelaComparativa from '../components/TabelaComparativa.astro';
import CalculadoraDoaci from '../components/CalculadoraDoaci.astro';

const egp = await getEntry('institucional', 'egp');
if (!egp) throw new Error('Registro "egp" ausente em src/data/institucional.yaml.');

const pagina = async (id: string) => {
  const entrada = await getEntry('paginas', id);
  if (!entrada) throw new Error(`Conteúdo "${id}" ausente em src/content/paginas/.`);
  return { data: entrada.data, ...(await render(entrada)) };
};

const inicio = await pagina('index');
const sobre = await pagina('sobre');
const servicos = await pagina('servicos');
const fluxos = await pagina('fluxos');
const doaci = await pagina('doaci');
const limites = await pagina('limites');
const ecossistema = await pagina('ecossistema');
const contato = await pagina('contato');

const pilares = (await getCollection('pilares')).sort((a, b) => a.data.ordem - b.data.ordem);
const corposPilares = await Promise.all(pilares.map(async (p) => ({ item: p, ...(await render(p)) })));

const listaFluxos = (await getCollection('fluxos')).sort((a, b) => a.data.numero - b.data.numero);
const corposFluxos = await Promise.all(listaFluxos.map(async (f) => ({ item: f, ...(await render(f)) })));

const unidades = (await getCollection('ecossistema')).sort((a, b) => a.data.ordem - b.data.ordem);
const corposUnidades = await Promise.all(unidades.map(async (u) => ({ item: u, ...(await render(u)) })));

const procedimentos = (await getCollection('procedimentos')).sort((a, b) => a.data.ordem - b.data.ordem);
const corposProcedimentos = await Promise.all(procedimentos.map(async (p) => ({ item: p, ...(await render(p)) })));

const faixasDoaci = (await getCollection('doaciFaixas')).sort((a, b) => a.data.ordem - b.data.ordem);
const referenciasDoaci = (await getCollection('doaciReferencias')).sort((a, b) => a.data.ordem - b.data.ordem);

const textosDoaci = await getEntry('calculadora', 'doaci');
if (!textosDoaci) throw new Error('Registro "doaci" ausente em src/data/calculadora.yaml.');

const fronteiras = (await getCollection('fronteiras')).sort((a, b) => a.data.ordem - b.data.ordem);
const canais = (await getCollection('contatos')).sort((a, b) => a.data.ordem - b.data.ordem);

---

<Base titulo={inicio.data.titulo} descricao={inicio.data.descricao}>
  <section class="hero">
    <div class="env hero__grade">
      <div>
        <h1>{inicio.data.manchete ?? inicio.data.titulo}</h1>
        <div class="prosa"><inicio.Content /></div>
        <ul class="apelidos">
          {egp.data.identidades.map((identidade) => <li>{identidade}</li>)}
        </ul>
        <div class="botoes">
          <a class="btn btn--primario" href="#contato">{egp.data.ctaNav}</a>
          <a class="btn btn--secundario" href="#servicos">Conhecer os serviços</a>
        </div>
      </div>
      <div class="missao">
        <h2>Missão</h2>
        <p>{egp.data.missao}</p>
      </div>
    </div>
  </section>

  <section class="secao" id="sobre" aria-labelledby="t-sobre">
    <div class="env">
      <div class="cabecalho-secao">
        <p class="etiqueta">Sobre o EGP</p>
        <h2 id="t-sobre">{sobre.data.chamadaSecao ?? sobre.data.titulo}</h2>
        <div class="prosa"><sobre.Content /></div>
      </div>

    </div>
  </section>

  <section class="secao" id="servicos" aria-labelledby="t-servicos">
    <div class="env">
      <div class="cabecalho-secao">
        <p class="etiqueta">Serviços</p>
        <h2 id="t-servicos">{servicos.data.chamadaSecao ?? servicos.data.titulo}</h2>
        <div class="prosa"><servicos.Content /></div>
      </div>

      <div class="pilares">
        {corposPilares.map(({ item, Content }) => (
          <article class="pilar" id={item.id}>
            <div class="pilar__icone" aria-hidden="true">{String(item.data.ordem).padStart(2, '0')}</div>
            <h3>{item.data.nome}</h3>
            <p class="pilar__objetivo">{item.data.objetivo}</p>
            <div class="prosa"><Content /></div>
            <div class="pilar__listas">
              <div>
                <h4>Atividades</h4>
                <ul>{item.data.atividades.map((a) => <li>{a}</li>)}</ul>
              </div>
              <div>
                <h4>Entregáveis</h4>
                <ul>{item.data.entregaveis.map((e) => <li>{e}</li>)}</ul>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="secao" id="fluxos" aria-labelledby="t-fluxos">
    <div class="env">
      <div class="cabecalho-secao">
        <p class="etiqueta">Como funciona</p>
        <h2 id="t-fluxos">{fluxos.data.chamadaSecao ?? fluxos.data.titulo}</h2>
        <div class="prosa"><fluxos.Content /></div>
      </div>

      <div class="grade">
        {corposFluxos.map(({ item, Content }) => (
          <article class="cartao fluxo" id={item.id}>
            <div class="passo__n" aria-hidden="true">{item.data.numero}</div>
            <h3>{item.data.nome}</h3>
            <div class="prosa"><Content /></div>
            <p class="na-pratica">
              <strong>Na prática</strong>
              {item.data.naPratica}
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="secao" id="doaci" aria-labelledby="t-doaci">
    <div class="env pilha">
      <div class="cabecalho-secao">
        <p class="etiqueta">{textosDoaci.data.etiqueta}</p>
        <h2 id="t-doaci">{doaci.data.chamadaSecao ?? doaci.data.titulo}</h2>
        <div class="prosa"><doaci.Content /></div>
      </div>

      <aside class="aviso escopo" aria-labelledby="t-doaci-escopo">
        <h3 class="escopo__titulo" id="t-doaci-escopo">{textosDoaci.data.tituloEscopo}</h3>
        <p class="escopo__texto">{textosDoaci.data.avisoEscopo}</p>
      </aside>

      <div class="documentos">
        <h3 class="doaci__titulo doaci__titulo--primeiro">{textosDoaci.data.tituloDocumentos}</h3>
        <ul class="documentos__lista">
          {referenciasDoaci
            .filter((ref) => ref.data.destaque)
            .map((ref) => (
              <li>
                <a class="documento" href={ref.data.url} rel="external noopener">
                  <span class="documento__nome">{ref.data.titulo}</span>
                  {ref.data.formato && <span class="documento__formato">{ref.data.formato}</span>}
                </a>
              </li>
            ))}
        </ul>
      </div>

      <CalculadoraDoaci
        textos={textosDoaci.data}
        faixas={faixasDoaci.map((f) => f.data)}
      />

      <h3 class="doaci__titulo">{textosDoaci.data.tituloProcedimentos}</h3>
      <ol class="procedimentos">
        {corposProcedimentos.map(({ item, Content }) => (
          <li class="cartao procedimento" id={item.id}>
            <div class="passo__n" aria-hidden="true">{item.data.ordem}</div>
            <h4>{item.data.nome}</h4>
            <p class="procedimento__resumo">{item.data.resumo}</p>
            <div class="prosa"><Content /></div>
            <p class="procedimento__norma">
              <strong>{textosDoaci.data.rotuloBaseNormativa}</strong>
              {item.data.baseNormativa}
            </p>
          </li>
        ))}
      </ol>

      <h3 class="doaci__titulo">{textosDoaci.data.tituloReferencias}</h3>
      <ul class="referencias">
        {referenciasDoaci.map((ref) => (
          <li class="cartao" id={ref.id}>
            <p class="referencia__orgao">{ref.data.orgao}</p>
            <h4>
              <a href={ref.data.url} rel="external noopener">{ref.data.titulo}</a>
              {ref.data.formato && <span class="documento__formato">{ref.data.formato}</span>}
            </h4>
            <p class="referencia__define">{ref.data.oQueDefine}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="secao" id="limites" aria-labelledby="t-limites">
    <div class="env pilha">
      <div class="cabecalho-secao">
        <p class="etiqueta">Limites de atuação</p>
        <h2 id="t-limites">{limites.data.chamadaSecao ?? limites.data.titulo}</h2>
        <div class="prosa"><limites.Content /></div>
      </div>
      <TabelaComparativa
        legenda="Fronteiras de responsabilidade entre o EGP e os coordenadores e setores."
        rotuloRegiao="Tabela de fronteiras de responsabilidade"
        linhas={fronteiras.map((f) => ({ id: f.id, egp: f.data.egp, coordenador: f.data.coordenador }))}
      />
    </div>
  </section>

  <section class="secao" id="ecossistema" aria-labelledby="t-ecossistema">
    <div class="env">
      <div class="cabecalho-secao">
        <p class="etiqueta">Ecossistema de inovação</p>
        <h2 id="t-ecossistema">{ecossistema.data.chamadaSecao ?? ecossistema.data.titulo}</h2>
        <div class="prosa"><ecossistema.Content /></div>
      </div>

      <div class="grade" style="margin-top: var(--esp-4)">
        {corposUnidades.map(({ item, Content }) => (
          <article class="cartao" id={item.id}>
            <h3>{item.data.nome}</h3>
            <p class="papel">{item.data.papel}</p>
            <dl>
              <dt>Relação com o EGP</dt>
              <dd>{item.data.relacaoComEgp}</dd>
            </dl>
            <div class="prosa"><Content /></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="secao" id="contato" aria-labelledby="t-contato">
    <div class="env">
      <div class="cabecalho-secao">
        <p class="etiqueta">Contato</p>
        <h2 id="t-contato">{contato.data.chamadaSecao ?? contato.data.titulo}</h2>
        <div class="prosa"><contato.Content /></div>
      </div>
      <ul class="canais">
        {canais.map((canal) => <CanalAtendimento canal={canal.data} nivel={3} />)}
      </ul>
      <p class="prosa endereco">{egp.data.nomeUnidade}</p>
    </div>
  </section>

  <section class="chamada" aria-labelledby="t-chamada">
    <div class="env chamada__grade">
      <div>
        <h2 id="t-chamada">{egp.data.chamadaTitulo}</h2>
        <p>{egp.data.chamadaTexto}</p>
      </div>
      <div class="botoes">
        {canais
          .filter((canal) => canal.data.situacao === 'ativo' && canal.data.tipo === 'email')
          .map((canal) => (
            <a class="btn btn--claro" href={`mailto:${canal.data.endereco}`}>{canal.data.endereco}</a>
          ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    background: var(--marca-suave);
    border-bottom: 1px solid var(--linha);
  }

  .hero__grade {
    display: grid;
    gap: var(--esp-4);
    padding-block: var(--esp-5);
    grid-template-columns: 1fr;
  }

  @media (min-width: 52rem) {
    .hero__grade {
      grid-template-columns: 3fr 2fr;
      align-items: start;
    }
  }

  h1 {
    margin: var(--esp-2) 0;
  }

  .hero .prosa {
    font-size: 1.125rem;
  }

  .apelidos {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    margin: var(--esp-3) 0;
    list-style: none;
  }

  .apelidos li {
    background: var(--superficie);
    border: 1px solid var(--linha);
    border-radius: 999px;
    padding: 0.35rem 0.85rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--marca-forte);
  }

  .botoes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .missao {
    background: var(--superficie);
    border: 1px solid var(--linha);
    border-left: 5px solid var(--marca);
    border-radius: var(--r);
    padding: var(--esp-3);
  }

  .missao h2 {
    margin: 0 0 0.5rem;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--marca-forte);
  }

  .secao h3 {
    margin-top: var(--esp-3);
  }

  .pilar__icone {
    width: 3rem;
    height: 3rem;
    border-radius: 12px;
    background: var(--marca-suave);
    color: var(--marca-forte);
    display: grid;
    place-items: center;
    font-weight: 700;
    font-size: 1.1rem;
  }

  .passo__n {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    background: var(--marca-forte);
    color: #fff;
    font-weight: 700;
  }

  .chamada {
    background: var(--marca-forte);
    color: #fff;
    padding-block: var(--esp-5);
  }

  .chamada__grade {
    display: grid;
    gap: var(--esp-3);
    grid-template-columns: 1fr;
  }

  .chamada__grade > *,
  .hero__grade > * {
    min-width: 0;
  }

  @media (min-width: 52rem) {
    .chamada__grade {
      grid-template-columns: 3fr 2fr;
      align-items: center;
    }
  }

  .chamada h2 {
    font-size: clamp(1.5rem, 1.2rem + 1.4vw, 2.2rem);
  }

  .chamada p {
    color: #cfe6da;
    margin: 0.6rem 0 0;
    max-width: var(--leitura);
  }

  .pilares {
    display: grid;
    gap: var(--esp-3);
    margin-top: var(--esp-4);
  }

  .pilar {
    background: var(--superficie);
    border: 1px solid var(--linha);
    border-radius: var(--r);
    padding: var(--esp-4);
  }

  .pilar h3 {
    margin: 0.25rem 0 0.5rem;
  }

  .pilar__objetivo {
    margin: 0;
  }

  .pilar__listas {
    display: grid;
    gap: var(--esp-3);
    margin-top: var(--esp-3);
    padding-top: var(--esp-3);
    border-top: 1px solid var(--linha);
  }

  @media (min-width: 46rem) {
    .pilar__listas {
      grid-template-columns: 1fr 1fr;
    }
  }

  .pilar__listas h4 {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--marca-forte);
    margin: 0 0 0.35rem;
  }

  .pilar__listas ul {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--texto-suave);
    font-size: 0.9375rem;
  }

  .pilar__listas li + li {
    margin-top: 0.35rem;
  }

  .fluxo__n {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--marca);
    letter-spacing: 0.1em;
    display: block;
  }

  .fluxo h3 {
    font-size: 1.125rem;
    margin: 0;
  }

  .na-pratica {
    background: var(--marca-suave);
    border-radius: 8px;
    padding: 0.75rem 0.9rem;
    font-size: 0.9375rem;
    margin: 0;
  }

  .na-pratica strong {
    display: block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--marca-forte);
  }

  .papel {
    margin: 0;
    color: var(--texto-suave);
    font-size: 0.9688rem;
  }

  dt {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--marca-forte);
    font-weight: 700;
  }

  dd {
    margin: 0.25rem 0 0;
    font-size: 0.9375rem;
    color: var(--texto-suave);
  }

  .doaci__titulo {
    margin: var(--esp-4) 0 0;
    font-size: 1.25rem;
  }

  .doaci__titulo--primeiro {
    margin-top: 0;
  }

  .escopo {
    border-left: 5px solid var(--destaque);
  }

  .escopo__titulo {
    margin: 0 0 0.4rem;
    font-size: 1.0625rem;
    color: var(--destaque);
  }

  .escopo__texto {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--texto-suave);
    max-width: var(--leitura);
  }

  .documentos > * + * {
    margin-top: var(--esp-2);
  }

  .documentos__lista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
  }

  .documento {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: 2.75rem;
    height: 100%;
    padding: 0.75rem var(--esp-2);
    background: var(--superficie);
    border: 1px solid var(--linha);
    border-left: 4px solid var(--marca);
    border-radius: var(--r);
    text-decoration: none;
    color: var(--marca-forte);
    font-weight: 600;
    font-size: 0.9375rem;
    line-height: 1.35;
  }

  .documento:hover {
    border-color: var(--marca);
    background: var(--marca-suave);
  }

  .documento__nome {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .documento__formato {
    flex: none;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    padding: 0.15rem 0.45rem;
    border-radius: 999px;
    background: var(--marca-suave);
    color: var(--marca-forte);
    border: 1px solid var(--marca);
  }

  .procedimentos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--esp-2);
    grid-template-columns: repeat(auto-fit, minmax(min(19rem, 100%), 1fr));
  }

  .procedimento h4 {
    margin: 0;
    font-size: 1.0625rem;
  }

  .procedimento__resumo {
    margin: 0;
    font-weight: 600;
    color: var(--texto);
  }

  .procedimento__norma {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--texto-suave);
    border-top: 1px solid var(--linha);
    padding-top: 0.75rem;
  }

  .procedimento__norma strong {
    display: block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--marca-forte);
  }

  .referencias {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--esp-2);
    grid-template-columns: repeat(auto-fit, minmax(min(19rem, 100%), 1fr));
  }

  .referencias h4 {
    margin: 0;
    font-size: 1rem;
    line-height: 1.35;
  }

  .referencia__orgao {
    margin: 0;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--marca-forte);
    font-weight: 700;
  }

  .referencia__define {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--texto-suave);
  }

  .canais {
    list-style: none;
    margin: var(--esp-3) 0 0;
    padding: 0;
    display: grid;
    gap: var(--esp-2);
    grid-template-columns: repeat(auto-fit, minmax(min(17rem, 100%), 1fr));
  }

  .endereco {
    margin-top: var(--esp-3);
    font-weight: 600;
    color: var(--texto);
  }
</style>

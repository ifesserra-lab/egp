---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import CanalAtendimento from '../components/CanalAtendimento.astro';

const pagina = await getEntry('paginas', 'contato');
if (!pagina) throw new Error('Conteúdo "contato" ausente em src/content/paginas/.');
const { Content } = await render(pagina);

const canais = (await getCollection('contatos')).sort((a, b) => a.data.ordem - b.data.ordem);
const egp = await getEntry('institucional', 'egp');
if (!egp) throw new Error('Registro "egp" ausente em src/data/institucional.yaml.');
---

<Base titulo={pagina.data.titulo} descricao={pagina.data.descricao} rotaAtual="/contato">
  <section class="secao">
    <div class="env">
      <h1>{pagina.data.titulo}</h1>
      <div class="prosa"><Content /></div>

      <h2>Canais oficiais</h2>
      <ul class="canais">
        {canais.map((canal) => <CanalAtendimento canal={canal.data} />)}
      </ul>

      <p class="prosa endereco">{egp.data.nomeUnidade}</p>
    </div>
  </section>
</Base>

<style>
  h2 {
    margin-top: var(--esp-4);
  }

  .canais {
    list-style: none;
    margin: var(--esp-2) 0 0;
    padding: 0;
    display: grid;
    gap: var(--esp-2);
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
  }

  .endereco {
    margin-top: var(--esp-3);
    font-weight: 600;
    color: var(--texto);
  }
</style>

---
import Base from '../layouts/Base.astro';
---

<Base
  titulo="Página não encontrada"
  descricao="A página solicitada não existe no site do Escritório de Gestão de Projetos do Campus Serra."
  rotaAtual="/404"
>
  <section class="secao">
    <div class="env pilha">
      <h1>Página não encontrada</h1>
      <p class="prosa">
        O endereço acessado não existe ou foi alterado em uma revisão da Carta de Serviços.
      </p>
      <p><a class="btn btn--primario" href="/">Voltar para a página inicial</a></p>
    </div>
  </section>
</Base>

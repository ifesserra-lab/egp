---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';

const pagina = await getEntry('paginas', 'servicos');
if (!pagina) throw new Error('Conteúdo "servicos" ausente em src/content/paginas/.');
const { Content } = await render(pagina);

const pilares = (await getCollection('pilares')).sort((a, b) => a.data.ordem - b.data.ordem);
const corpos = await Promise.all(pilares.map(async (pilar) => ({ pilar, render: await render(pilar) })));
---

<Base titulo={pagina.data.titulo} descricao={pagina.data.descricao} rotaAtual="/servicos">
  <section class="secao">
    <div class="env">
      <h1>{pagina.data.titulo}</h1>
      <div class="prosa"><Content /></div>

      <div class="pilares">
        {
          corpos.map(({ pilar, render: { Content: Corpo } }) => (
            <article class="pilar" id={pilar.id}>
              <p class="etiqueta">Pilar {String(pilar.data.ordem).padStart(2, '0')}</p>
              <h2>{pilar.data.nome}</h2>
              <p class="pilar__objetivo">{pilar.data.objetivo}</p>
              <div class="pilar__corpo prosa">
                <Corpo />
              </div>
              <div class="pilar__listas">
                <div>
                  <h3>Atividades</h3>
                  <ul>
                    {pilar.data.atividades.map((item) => <li>{item}</li>)}
                  </ul>
                </div>
                <div>
                  <h3>Entregáveis</h3>
                  <ul>
                    {pilar.data.entregaveis.map((item) => <li>{item}</li>)}
                  </ul>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .pilares {
    display: grid;
    gap: var(--esp-3);
    margin-top: var(--esp-4);
  }

  .pilar {
    background: var(--superficie);
    border: 1px solid var(--linha);
    border-radius: var(--r);
    padding: var(--esp-4);
  }

  .pilar h2 {
    margin: 0.25rem 0 0.5rem;
  }

  .pilar__objetivo {
    font-size: 1.0625rem;
    margin: 0;
  }

  .pilar__corpo {
    margin-top: var(--esp-2);
  }

  .pilar__listas {
    display: grid;
    gap: var(--esp-3);
    margin-top: var(--esp-3);
    padding-top: var(--esp-3);
    border-top: 1px solid var(--linha);
  }

  @media (min-width: 46rem) {
    .pilar__listas {
      grid-template-columns: 1fr 1fr;
    }
  }

  .pilar__listas h3 {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--marca-forte);
    margin: 0 0 0.35rem;
  }

  .pilar__listas ul {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--texto-suave);
    font-size: 0.9375rem;
  }

  .pilar__listas li + li {
    margin-top: 0.35rem;
  }
</style>

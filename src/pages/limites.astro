---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import TabelaComparativa from '../components/TabelaComparativa.astro';

const pagina = await getEntry('paginas', 'limites');
if (!pagina) throw new Error('Conteúdo "limites" ausente em src/content/paginas/.');
const { Content } = await render(pagina);

const fronteiras = (await getCollection('fronteiras')).sort((a, b) => a.data.ordem - b.data.ordem);
---

<Base titulo={pagina.data.titulo} descricao={pagina.data.descricao} rotaAtual="/limites">
  <section class="secao">
    <div class="env pilha">
      <h1>{pagina.data.titulo}</h1>
      <div class="prosa"><Content /></div>
      <TabelaComparativa
        legenda="Fronteiras de responsabilidade entre o EGP e os coordenadores e setores."
        rotuloRegiao="Tabela de fronteiras de responsabilidade"
        linhas={fronteiras.map((f) => ({ id: f.id, egp: f.data.egp, coordenador: f.data.coordenador }))}
      />
    </div>
  </section>
</Base>

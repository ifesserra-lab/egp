{
  "name": "site-egp-serra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Site institucional do Escritório de Gestão de Projetos (EGP) do Campus Serra — Ifes",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "serve:dist": "astro preview --port 4321",
    "test:a11y": "pa11y-ci",
    "test:links": "linkinator http://localhost:4321 --recurse --skip \"^https?://(?!localhost)\"",
    "test:perf": "lhci autorun",
    "verify": "npm run check && npm run build && npm run preview:start && npm run test:links && npm run test:a11y && npm run preview:stop",
    "preview:start": "astro preview",
    "preview:stop": "astro preview stop"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.3",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@lhci/cli": "^0.15.1",
    "linkinator": "^8.1.0",
    "pa11y-ci": "^4.1.1",
    "typescript": "^5.9.2"
  }
}
